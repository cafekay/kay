---
const pathname = Astro.url.pathname;
const links = [
  { href: "/works", label: "Works" },
  { href: "/about", label: "About" },
  { href: "/capabilities", label: "Capabilities" },
  { href: "/contact", label: "Contact" }
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="KH科合视造首页">
    <span>KH</span>
    <span class="wordmark-cn">科合视造</span>
  </a>

  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button>
    <span>Menu</span>
  </button>

  <nav id="site-menu" class="site-nav" aria-label="主导航" data-menu>
    {links.map((link) => (
      <a href={link.href} aria-current={pathname.startsWith(link.href) ? "page" : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
