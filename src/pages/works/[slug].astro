---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cases, type CaseCategory } from "@/data/cases";

const categoryNames: Record<CaseCategory, string> = {
  "brand-identity": "品牌视觉",
  "commercial-film": "商业影像",
  "digital-creation": "数字创意",
  "brand-experience": "品牌体验"
};

export function getStaticPaths() {
  return cases.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout title={`${item.title} | KH科合视造`} description={`${item.title}，${item.categoryLabel}案例。`} image={item.cover}>
  <a class="page-close" href={`/works/category/${item.category}`} aria-label={`关闭并返回${categoryNames[item.category]}案例`}>
    <span aria-hidden="true">×</span>
  </a>
  <article class="work-detail">
    <header class="work-detail-header">
      <p>{item.categoryLabel}</p>
      <h1>{item.title}</h1>
    </header>
    <div class:list={["work-detail-media", item.orientation === "portrait" && "is-portrait"]}>
      {item.preview ? (
        <video src={item.preview} poster={item.cover} controls playsinline preload="metadata"></video>
      ) : (
        <img src={item.cover} alt={`${item.title}项目视觉`} width="1600" height="1000" />
      )}
    </div>
    <a class="text-link back-to-works" href={`/works/category/${item.category}`}>返回{categoryNames[item.category]}案例</a>
  </article>
</BaseLayout>
