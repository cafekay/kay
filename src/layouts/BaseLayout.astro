---
import "@fontsource/barlow-condensed/300.css";
import "@fontsource/barlow-condensed/400.css";
import "@fontsource/barlow-condensed/500.css";
import "@fontsource-variable/noto-sans-sc";
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "KH科合视造 | Visual Creative Studio",
  description = "KH科合视造专注品牌视觉、商业影像、数字创意与品牌体验，以视觉语言建立清晰而持久的品牌感知。",
  image = "/visuals/hero-dappled-light.webp"
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090907" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="zh_CN" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/brand/kh-mark-white.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-backdrop" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      const menuButton = document.querySelector("[data-menu-button]");
      const menu = document.querySelector("[data-menu]");
      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!open));
        menu?.toggleAttribute("data-open", !open);
      });

      const videos = document.querySelectorAll("video[data-preview-start]");
      const cuePreviewStart = (video) => {
        if (!(video instanceof HTMLVideoElement)) return;
        const startTime = Number(video.dataset.previewStart ?? 0);
        if (video.readyState >= HTMLMediaElement.HAVE_METADATA) video.currentTime = startTime;
      };

      videos.forEach((video) => {
        if (!(video instanceof HTMLVideoElement)) return;
        if (video.readyState >= HTMLMediaElement.HAVE_METADATA) {
          cuePreviewStart(video);
        } else {
          video.addEventListener("loadedmetadata", () => cuePreviewStart(video), { once: true });
        }

        video.addEventListener("play", () => {
          videos.forEach((otherVideo) => {
            if (otherVideo instanceof HTMLVideoElement && otherVideo !== video) otherVideo.pause();
          });
        });

        video.addEventListener("ended", () => cuePreviewStart(video));
      });
    </script>
  </body>
</html>
